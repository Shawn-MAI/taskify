# Copy to .env and fill in. Never commit real values.
# Shared service credential used by the web service to call the API.
TASKIFY_API_TOKEN=
# Django secret key for the web service.
DJANGO_SECRET_KEY=
# "production" enables HTTPS redirect, secure cookies and HSTS in the web service.
TASKIFY_ENV=development
# Base URL of the API service as seen by the web service.
TASKIFY_API_URL=http://localhost:8001
